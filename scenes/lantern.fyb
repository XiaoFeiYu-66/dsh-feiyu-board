canvas 1000x1200
bg #FBF7F0

# 照参考图第一行的灯笼。
# 三处是第一版翻车的：灯身要真的圆（点太少会成圆角方）、
# 花边要顺着灯身弧走（不能是横着一条带子）、流苏别在底下垫一块。
hand preset=brush seed=77

let 红 = #E23B2E
let 红暗 = #C02C22
let 金 = #F3C24B
let 金深 = #D79E2B
let 线 = #3B2E27

group at=[500,560]

  # 1) 灯身：16 个点落在椭圆上 —— 直接拿圆角方会显得"方"
  curve [196,0 181,71 138,126 75,172 0,186 -75,172 -138,126 -181,71 \
         -196,0 -181,-71 -138,-126 -75,-172 0,-186 75,-172 138,-126 181,-71] \
        fill=$红 stroke=none closed name=身
  grad ref=身 from=#FF7350 to=#B42418 p0=[-150,-160] p1=[150,170]

  # 2) 竖棱：裁在灯身里，越靠边越向外鼓
  clip 身
    curve [0,-192 8,-60 0,60 -8,192] w=7 stroke=$金 alpha=0.9 taper=0.15
    curve [-70,-186 -92,-60 -70,60 -48,186] w=7 stroke=$金 alpha=0.85 taper=0.15
    curve [70,-186 92,-60 70,60 48,186] w=7 stroke=$金 alpha=0.85 taper=0.15
    curve [-134,-162 -176,-56 -134,56 -96,162] w=7 stroke=$金 alpha=0.75 taper=0.15
    curve [134,-162 176,-56 134,56 96,162] w=7 stroke=$金 alpha=0.75 taper=0.15
  endclip

  # 3) 轮廓
  curve [196,0 181,71 138,126 75,172 0,186 -75,172 -138,126 -181,71 \
         -196,0 -181,-71 -138,-126 -75,-172 0,-186 75,-172 138,-126 181,-71] \
        fill=none stroke=$线 w=10 closed

  # 4) 上下花边：顺着灯身弧的波浪带。
  #    做法是**同一条路径画两遍**：先粗的深色打底，再细的金色压上去，
  #    就得到"有描边的金带"，比填一个多边形干净。
  #    必须 clip 到灯身里 —— 不裁的话两头会翘到轮廓外面去（第二版就是这样）。
  clip 身
    curve [-150,-158 -122,-176 -94,-158 -66,-176 -38,-158 -10,-176 \
           18,-158 46,-176 74,-158 102,-176 130,-158 158,-138] \
          w=22 stroke=$线 taper=0
    curve [-150,-158 -122,-176 -94,-158 -66,-176 -38,-158 -10,-176 \
           18,-158 46,-176 74,-158 102,-176 130,-158 158,-138] \
          w=14 stroke=$金 taper=0
    curve [-158,118 -130,138 -102,120 -74,140 -46,122 -18,142 \
           10,124 38,142 66,122 94,140 122,120 150,138] \
          w=22 stroke=$线 taper=0
    curve [-158,118 -130,138 -102,120 -74,140 -46,122 -18,142 \
           10,124 38,142 66,122 94,140 122,120 150,138] \
          w=14 stroke=$金 taper=0
  endclip

  # 5) 上盖：只用两件 —— 短红筒 + 金顶。
  #    不要再垫一个金圈：花边本身就是那一圈，再垫会变成"三层等宽的饼"（第四版）。
  curve [-56,-186 56,-186 58,-224 -58,-224] fill=$红暗 stroke=$线 w=8 closed
  ellipse 0,-226,60,13 fill=$金 stroke=$线 width=6

  # 6) 下盖
  ellipse 0,186,58,13 fill=$金 stroke=$线 width=6
  curve [-40,190 40,190 34,222 -34,222] fill=$红暗 stroke=$线 w=8 closed

  # 7) 流苏：一个结 + 五根散开的穗（不要垫底那块椭圆，会像桌子）
  ellipse 0,232,22,14 fill=$红 stroke=$线 width=5
  curve [-14,244 -30,286 -44,330] w=8 stroke=$红 taper=0.5
  curve [-7,246 -16,290 -22,344] w=8 stroke=$红暗 taper=0.5
  curve [0,248 0,296 0,352] w=9 stroke=$红 taper=0.45
  curve [7,246 16,290 22,344] w=8 stroke=$红暗 taper=0.5
  curve [14,244 30,286 44,330] w=8 stroke=$红 taper=0.5

  # 8) 脸
  ellipse -58,-4,11,16 fill=$线
  ellipse 58,-4,11,16 fill=$线
  curve [-24,28 -6,42 24,26] w=7 stroke=$线 taper=0.3
  ellipse -104,24,22,11 fill=#F6B5A6 alpha=0.7
  ellipse 104,24,22,11 fill=#F6B5A6 alpha=0.7

endgroup

shadow ref=身 dx=10 dy=26 blur=40 alpha=0.16 color=#8A6B4A

text 60,1130 "灯笼 · 照参考图" 26 align=left color=#8A7360 hand=0.3
