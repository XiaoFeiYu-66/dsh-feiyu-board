ink [960,584 960,606] w=6 color=#3A2A1E taper=0
ink [960,606 916,636] w=6 color=#3A2A1E taper=0.4
ink [960,606 1004,636] w=6 color=#3A2A1E taper=0.4

# 胡须
ink [700,540 560,516] w=5 color=#3A2A1E taper=0.7 jitter=0.5
ink [700,580 548,588] w=5 color=#3A2A1E taper=0.7 jitter=0.5
ink [700,618 560,660] w=5 color=#3A2A1E taper=0.7 jitter=0.5
ink [1220,540 1360,516] w=5 color=#3A2A1E taper=0.7 jitter=0.5
ink [1220,580 1372,588] w=5 color=#3A2A1E taper=0.7 jitter=0.5
ink [1220,618 1360,660] w=5 color=#3A2A1E taper=0.7 jitter=0.5

# 腮红
circle 790,566,44 fill=#F2795F alpha=0.28
circle 1130,566,44 fill=#F2795F alpha=0.28

# 前爪：两个椭圆，压在脸上
