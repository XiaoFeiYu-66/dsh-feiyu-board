canvas 1920x1080
bg #FDF1DF

hand preset=child seed=31

# 一坨影子，贴纸才有重量
shadow ref=head dx=0 dy=18 alpha=0.12

# 耳朵（先画，藏在头后面）
poly [700,330 632,150 812,196] fill=#E9A968 stroke=#3A2A1E width=9
poly [1220,330 1288,150 1108,196] fill=#E9A968 stroke=#3A2A1E width=9
poly [708,272 678,191 759,212] fill=#F2A9A0
poly [1212,272 1242,191 1161,212] fill=#F2A9A0
# 头
ellipse 960,470,300,262 fill=#F6C48B stroke=#3A2A1E width=9 name=head

# 斑纹
ink [900,250 930,330] w=9 color=#D98F52 taper=0.5 jitter=1.0
ink [960,238 960,326] w=9 color=#D98F52 taper=0.5 jitter=1.0
ink [1020,250 990,330] w=9 color=#D98F52 taper=0.5 jitter=1.0

# 眼睛
circle 862,470,30 fill=#1F2937
circle 1058,470,30 fill=#1F2937
circle 852,458,11 fill=#FFFFFF
circle 1048,458,11 fill=#FFFFFF

# 鼻子和嘴
