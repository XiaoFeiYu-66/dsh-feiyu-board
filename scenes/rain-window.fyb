canvas 1920x1080
bg #070A0D

hand preset=ink seed=17

# ── 房间：墙、墙脚、地 ──────────────────────────────
grad rect 0,0,1920,1012 from=#131C23 to=#0A0F14 dir=90
rect 0,1002,1920,12 fill=#0D1318
rect 0,1014,1920,66 fill=#05080A

# ── 窗（梯形：左边近、右边远）─────────────────────
# 墙的厚度：开口外沿先压一道暗边
poly [210,96 196,800 170,812 186,96] fill=#080C10
poly [186,96 170,812 196,826 1078,816 1064,128] fill=#0B1116

grad poly [210,96 1064,128 1078,790 196,800] from=#203345 to=#101C26 dir=90 name=glasswin

clip glasswin
  # 对面的楼：先画，雨才落在它前面
  poly [430,520 430,900 604,900 604,520 566,498 468,498] fill=#142534 alpha=0.45
  rect 470,560,60,44 fill=#C9A25E alpha=0.45
  rect 470,560,60,44 stroke=#7A6238 width=3

  # 雨：全画在开口里，超出的部分被裁掉
  ink [250,60 300,300] w=3 color=#4E7B94 alpha=0.6 jitter=0.45 taper=0.6
  ink [420,60 470,330] w=3 color=#56889F alpha=0.6 jitter=0.45 taper=0.6
  ink [580,200 640,470] w=2.5 color=#456B82 alpha=0.55 jitter=0.45 taper=0.6
  ink [700,50 760,330] w=3 color=#4E7B94 alpha=0.6 jitter=0.45 taper=0.6
  ink [920,60 980,340] w=3 color=#56889F alpha=0.6 jitter=0.45 taper=0.6
  ink [300,300 350,560] w=2.5 color=#456B82 alpha=0.55 jitter=0.45 taper=0.6
  ink [600,330 660,620] w=2.5 color=#496F86 alpha=0.55 jitter=0.45 taper=0.6
  ink [760,300 790,470] w=3 color=#56889F alpha=0.55 jitter=0.45 taper=0.6
  ink [900,340 960,640] w=2.5 color=#456B82 alpha=0.5 jitter=0.45 taper=0.6
  ink [270,540 320,800] w=3 color=#4E7B94 alpha=0.55 jitter=0.45 taper=0.6
  ink [560,560 620,830] w=3 color=#56889F alpha=0.5 jitter=0.45 taper=0.6
  ink [920,570 980,860] w=3 color=#4E7B94 alpha=0.5 jitter=0.45 taper=0.6
  ink [340,650 390,900] w=2.5 color=#456B82 alpha=0.45 jitter=0.45 taper=0.6
  ink [880,680 940,960] w=2.5 color=#56889F alpha=0.45 jitter=0.45 taper=0.6
  ink [1020,540 1046,700] w=2.5 color=#456B82 alpha=0.45 jitter=0.45 taper=0.6
endclip

# 窗框：沿梯形的边描一圈，再插两根窗棂
poly [210,96 1064,128 1078,790 196,800 210,96] stroke=#33454F width=14
ink [604,111 602,795] w=9 color=#33454F jitter=0.06 taper=0
ink [204,406 1070,419] w=9 color=#33454F jitter=0.06 taper=0

# ── 窗台：有厚度的一层 ──────────────────────────────
poly [148,800 1128,790 1156,814 140,826] fill=#2E3438
poly [140,826 1156,814 1156,852 140,866] fill=#1A1F22

# ── 鱼缸 ────────────────────────────────────────────
shadow ref=glass dx=0 dy=16 alpha=0.32
curve [600,517 640,528 737,532 834,528 874,517 882,576 884,646 872,716 \
       838,764 786,790 722,792 664,772 620,724 596,656 588,582] \
      fill=#BFE0EE alpha=0.08 closed name=glass

clip glass
  grad rect 480,592,520,280 from=#9AD0E655 to=#417E9B77 dir=90
  # 水面：一个扁椭圆，水才有"面"而不是一条线
  curve [874,588 834,601 737,606 640,601 598,588 640,575 737,570 834,575] \
        fill=#8EC6DE alpha=0.30 closed
  ink [598,588 640,575 737,570 834,575 874,588] w=2 color=#BFE0F0 alpha=0.45 jitter=0.2

  shadow ref=fishbody dx=2 dy=10 alpha=0.28
  curve [700,660 718,638 748,630 776,638 790,660 776,682 748,688 718,682] \
        fill=#E8A33D closed name=fishbody
  poly [790,660 826,642 818,678] fill=#E8A33D
  circle 712,654,5 fill=#1A1A1A
  ink [720,672 736,679 752,672] w=3 color=#A96A16 jitter=0.2 taper=0.4
  ink [778,646 790,660 778,676] w=2.5 color=#FFD9A0 alpha=0.55 jitter=0.15 taper=0.5
endclip

ink [600,517 640,528 737,532 834,528 874,517 882,576 884,646 872,716 \
     838,764 786,790 722,792 664,772 620,724 596,656 588,582 600,517] \
    w=4 color=#6F97AC alpha=0.85 taper=0.12 jitter=0.22 step=7
ink [868,540 878,622 866,702 838,754] w=3 color=#FFD9A0 alpha=0.40 jitter=0.15 taper=0.5

# 窗框右段沾到暖光
ink [1068,146 1082,780] w=5 color=#B08A4E alpha=0.28 jitter=0.1 taper=0.2

# ── 吊灯 ────────────────────────────────────────────
ink [1500,-10 1500,190] w=4 color=#232323 jitter=0.15 taper=0
poly [1450,190 1550,190 1586,300 1414,300] fill=#3B3B3E
grad poly [1470,306 1530,306 1640,1080 1360,1080] from=#FFD98A2E to=#FFD98A00 dir=90
grad poly [1414,306 1586,306 1800,1080 1200,1080] from=#FFD98A14 to=#FFD98A00 dir=90
grad circle 1500,306,330 from=#FFD98A33 to=#FFD98A00
circle 1500,306,60 fill=#FFE9B8 alpha=0.14
circle 1500,306,26 fill=#FFF3D0 alpha=0.55
circle 1500,306,12 fill=#FFFFFF alpha=0.85

# ── 压暗四角 ────────────────────────────────────────
grad circle 860,520,1320 from=#00000000 to=#000000C4

# ── 字 ──────────────────────────────────────────────
text 210,980 "凌晨一点" 44 align=left color=#C9BFAE hand=0.28
text 212,1018 "雨没停。鱼还醒着，我该睡了。" 22 align=left color=#7C7468 hand=0.35
