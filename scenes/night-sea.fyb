# 深海的夜（第十四版：按老师的四条重排）
# 顺序照老师说的：先大形（三块位置），再光。
canvas 1920x1080
bg #04080E

# ──【大形】三块：鲸在左下，月亮在顶，人在右下 ──
# 1. 月亮：顶角，居中偏上
# 2. 鲸：左下，跃出水面
# 3. 人：右下，一盏灯

# ──【天】──
grad rect 0,0,1920,700 from=#0B1B33 to=#17385C dir=90

# 月（顶角）
circle 960,188,96 fill=#FFFDF2
blur 54
  circle 960,188,182 fill=#FFF6DE4D
endblur
blur 20
  circle 960,184,78 fill=#FFFFF84A
endblur

# 星
circle 300,150,2.6 fill=#DCE9FF alpha=0.8
circle 560,88,2 fill=#DCE9FF alpha=0.55
circle 700,250,2.4 fill=#DCE9FF alpha=0.5
circle 1240,120,2.2 fill=#DCE9FF alpha=0.55
circle 1520,262,2.6 fill=#DCE9FF alpha=0.6
circle 1700,150,1.8 fill=#DCE9FF alpha=0.4
circle 400,320,1.8 fill=#DCE9FF alpha=0.4
circle 1380,340,1.6 fill=#DCE9FF alpha=0.35

# 雾带（海天接缝）
blur 30
  rect 0,612,1920,92 fill=#8FB6D82A
endblur

# ──【海】──
grad rect 0,656,1920,424 from=#0B2438 to=#030910 dir=90

# 月光落在水面：正下方一条竖的光路（因为月亮在中间）
blur 26
  blend screen
    grad rect 920,656,86,424 from=#F7F1DE55 to=#F7F1DE00 dir=90
    grad rect 1010,656,58,340 from=#F7F1DE3B to=#F7F1DE00 dir=90
    grad rect 860,656,44,300 from=#F7F1DE26 to=#F7F1DE00 dir=90
  endblend
endblur

ink [120,780 420,776 700,784] w=5 color=#5C8FBF alpha=0.2 taper=0.6
ink [1180,830 1400,824 1600,834] w=4 color=#5C8FBF alpha=0.16 taper=0.6

# ──【鲸】左下 ──
group scale=1.12 about=[600,560]
  # 一整条轮廓：嘴→额→背→尾柄→尾鳍上缘→缺口→下缘→肚皮→回嘴
  # 厚身子（回到 v15 的体量）+ 尾鳍根部压进身体 26px
  poly [354,718 342,696 346,666 368,638 438,592 512,540 592,506 664,490 712,484 742,480 742,520 714,536 660,572 596,618 516,662 452,704] fill=#060D17 name=whale
  curve [700,492 762,466 826,404 852,350 864,386 848,420 814,450 858,478 884,500 884,502 866,514 840,520 800,518 742,524 700,532] closed fill=#060D17
  # 受光：月亮在正上方，所以背上亮、腹下暗
  curve [456,672 516,690 556,664 500,646] closed fill=#0A1520
  ink [352,678 452,674 552,646 632,606] w=4 color=#21384E alpha=0.7 taper=0.5
  circle 388,642,5.5 fill=#DCE9FF alpha=0.6
  ink [346,700 424,704 486,694] w=5 color=#0A1520 alpha=0.9 taper=0.3
endgroup

# 出水：只借月光的冷白，不再自发光
blur 18
  ellipse 272,720,84,16 fill=#9FC4E63D
endblur
circle 296,696,3.6 fill=#CFE4F8 alpha=0.3
circle 282,678,2.8 fill=#CFE4F8 alpha=0.26
circle 302,660,2.2 fill=#CFE4F8 alpha=0.22
circle 288,644,1.8 fill=#CFE4F8 alpha=0.18
circle 270,662,1.6 fill=#CFE4F8 alpha=0.15

# ──【人】右下，一盏灯 ──
group at=[1420,798] scale=1.15
  curve [-92,6 -64,-8 34,-10 84,0 70,28 -32,32] closed fill=#050B14
  ink [-88,4 -60,-6 34,-8 80,-1] w=3 color=#8FB6D8 alpha=0.5 taper=0.7
  circle -12,-26,11 fill=#050B14
  ink [-22,-28 -14,-36] w=3 color=#8FB6D8 alpha=0.32 taper=0.8
  curve [-22,-14 -14,-2 8,2 16,-8 4,-16 -12,-16] closed fill=#050B14
  ink [8,-10 30,-46] w=4 color=#050B14 taper=0.35
  blur 24
    circle 34,-56,38 fill=#FFC27A3D
  endblur
  blur 10
    circle 34,-56,16 fill=#FFD79A55
  endblur
  circle 34,-56,7 fill=#FFE9C4
endgroup

# 船下的灯影
ellipse 1454,846,52,12 fill=none stroke=none name=reflb
blend screen
  grad ref=reflb from=#FFC27A44 to=#FFC27A00
endblend

# ──【前景】──
ink [0,1010 320,1000 640,1014] w=9 color=#122A3E alpha=0.8 taper=0.5
ink [700,1046 1080,1036 1420,1050] w=8 color=#122A3E alpha=0.7 taper=0.5
ink [1180,980 1520,974 1850,986] w=5 color=#5C8FBF alpha=0.12 taper=0.6

# 暗角
grad circle 960,520,1260 from=#00000000 to=#000000AA
























