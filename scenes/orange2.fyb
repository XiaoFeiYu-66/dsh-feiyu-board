canvas 1024x1024
bg #FDFDFB

include "lib/parts.fyb"

# ── 色板：只改这一段，整张图跟着变 ───────────────────
let 橙亮 = #FFA62E
let 橙暗 = #D4240C
let 孔色 = #A8130A
let 奶油 = #FFE3B4
let 奶油2 = #FFEFD2
let 边光 = #FFC93C
let 叶亮 = #7FC241
let 叶中 = #6FB92F
let 茎绿 = #66AD33

hand preset=ink seed=41

# ── 果身 ─────────────────────────────────────────────
circle 490,570,305 fill=#F0561C name=body

clip body
  grad rect 185,265,610,610 from=$橙亮 to=$橙暗 dir=90

  # 斑驳：小块才看得出"斑"，一大片就只是变暗
  blend multiply
    grad circle 320,470,150 from=#E85028A8 to=#E8502800
    grad circle 470,560,170 from=#C0200AB8 to=#C0200A00
    grad circle 640,500,150 from=#E05028A0 to=#E0502800
    grad circle 300,660,160 from=#B81A08B8 to=#B81A0800
    grad circle 500,740,180 from=#C0200AB0 to=#C0200A00
    grad circle 700,700,150 from=#B01406B0 to=#B0140600
    grad circle 400,850,150 from=#A81206A8 to=#A8120600
    grad circle 600,880,160 from=#B01808A8 to=#B0180800
    grad circle 380,380,130 from=#FF9A60A0 to=#FF9A6000
  endblend

  # 顶部暖光：最后加，别被 multiply 吃掉
  blend screen
    grad circle 460,330,240 from=#FFD9A044 to=#FFD9A000
  endblend

  气孔 300,470,7,0.20
  气孔 360,520,6,0.20
  气孔 420,470,5,0.18
  气孔 300,616,6,0.24
  气孔 390,560,8,0.20
  气孔 470,650,6,0.22
  气孔 560,500,7,0.18
  气孔 600,560,6,0.22
  气孔 660,610,7,0.20
  气孔 520,720,7,0.22
  气孔 610,700,5,0.18
  气孔 400,760,6,0.20
  气孔 340,420,5,0.16
  气孔 680,540,5,0.16
  气孔 500,420,6,0.16
  气孔 260,520,5,0.18

  curve [770,380 796,470 792,600 756,720 736,700 768,590 772,470 752,400] \
        fill=$边光 alpha=0.55
endclip

# ── 左侧两道高光（顺着球面走弧，且必须留在轮廓里）────────
clip body
  curve [302,356 258,418 244,478 250,528] w=18 stroke=$奶油 alpha=0.85 taper=0.6 jitter=0.2
  curve [352,350 322,406 312,460 320,502] w=9 stroke=$奶油2 alpha=0.8 taper=0.65 jitter=0.2
endclip

# ── 花萼 ─────────────────────────────────────────────
curve [505,300 529,340 579,348 543,384 551,435 505,412 459,435 467,384 \
       431,348 481,340] fill=$叶中 closed
curve [505,330 519,352 545,356 525,376 530,402 505,392 480,402 485,376 \
       465,356 491,352] fill=$叶暗 alpha=0.55 closed

def 皱 (pts, a)
  ink $pts w=3 color=$叶暗 alpha=$a taper=0.7
enddef
皱 [505,418 505,446] 0.45
皱 [466,404 442,420] 0.45
皱 [544,404 568,420] 0.45
皱 [436,344 418,332] 0.35
皱 [574,344 592,332] 0.35

# ── 果柄 ─────────────────────────────────────────────
curve [508,404 504,344 506,288 514,236] w=21 stroke=$茎绿 taper=0.12 jitter=0.3
ink [502,392 499,320 504,250] w=6 color=#8FD24A alpha=0.75 taper=0.5
ink [516,380 517,300 522,244] w=5 color=$叶暗 alpha=0.55 taper=0.5

# ── 小叶子 ───────────────────────────────────────────
ink [520,224 542,232 556,236] w=4 color=$茎绿 alpha=0.9 taper=0.5
curve [552,232 574,196 630,168 700,160 698,188 646,220 590,244] fill=$叶亮 closed
叶脉线 [570,228 624,194 688,172] 3
ink [570,228 604,212 650,204] w=2.5 color=$叶暗 alpha=0.5 taper=0.5

# ── 大叶子 ───────────────────────────────────────────
curve [626,292 668,266 720,266 776,300 820,356 848,444 802,430 748,404 \
       700,372 656,334] fill=$叶中 closed
叶脉线 [642,300 700,332 762,378 826,432] 3.5
ink [664,282 704,296 744,302] w=2.5 color=$叶暗 alpha=0.45 taper=0.6
ink [702,344 728,370] w=2.5 color=$叶暗 alpha=0.45 taper=0.6
ink [754,380 784,402] w=2.5 color=$叶暗 alpha=0.45 taper=0.6
