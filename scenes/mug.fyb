canvas 1000x1000
bg #FBF7F0

# 照参考图最下面那个马克杯：先是身体，加把手，再加碟子和杯口。
# 参考图的特点：粗圆线、平面填色、一张小脸。
#
# 层序很重要（第一版就是这里翻的车）：
#   影子 → 碟子 → 把手 → 杯身 → 杯口 → 脸
# 碟子必须在杯身**之前**，否则盘子会盖住杯底，杯子像陷进去了；
# 把手必须在杯身之前，这样接头被杯身吃掉，才不会看出两根断头。
hand preset=brush seed=64

let 线 = #3B2E27
let 杯身 = #F7E8D3
let 碟 = #F2E3CC
let 咖啡 = #6B4229
let 腮红 = #F6B5A6

group at=[500,470]

  # 1) 影子
  shadow ref=碟 dx=3 dy=12 blur=20 alpha=0.16 color=#8A6B4A

  # 2) 碟子：比杯身宽一圈，扁一点
  ellipse 0,178,208,44 fill=$碟 name=碟
  ellipse 0,178,208,44 fill=none stroke=$线 width=8
  ellipse 0,164,172,28 fill=none stroke=#DCC8AA width=4

  # 3) 把手：正圆弧（在圆心 145,0 半径 100 的圆上取 13 个点），
  #    两头伸到 ±90° 埋进杯身里。第一版只给了 7 个点，弧就变成了方角。
  curve [145,-100 171,-97 195,-87 216,-71 232,-50 242,-26 245,0 \
         242,26 232,50 216,71 195,87 171,97 145,100] \
        w=22 stroke=$线 taper=0

  # 4) 杯身：圆角方，侧边微微鼓
  #    拆成"填色 → 渐变 → 描边"三步：渐变画在描边前面才不会把轮廓洗淡
  #    （第一版是一条命令画完，grad 盖在描边上，左边轮廓就虚了）。
  curve [0,-152 62,-150 116,-138 146,-112 156,-72 158,-12 156,48 148,98 \
         130,136 90,160 0,166 -90,160 -130,136 -148,98 -156,48 -158,-12 \
         -156,-72 -146,-112 -116,-138 -62,-150] \
        fill=$杯身 stroke=none closed name=身

  # 5) 体积：右侧压一点暗（自定义轴，左上到右下）
  grad ref=身 from=#FFFFFF00 to=#C9A87C4D p0=[-150,-140] p1=[165,150]

  #   轮廓跟着填色一起画，笔重 10
  curve [0,-152 62,-150 116,-138 146,-112 156,-72 158,-12 156,48 148,98 \
         130,136 90,160 0,166 -90,160 -130,136 -148,98 -156,48 -158,-12 \
         -156,-72 -146,-112 -116,-138 -62,-150] \
        fill=none stroke=$线 w=10 closed

  # 6) 杯口：外圈 + 内壁的暗 + 咖啡面（咖啡自己有深浅，不是一块平色）
  #    杯口要画在杯身轮廓**之后**，让它压住杯顶那条线 ——
  #    反过来就会变成"一个环浮在杯身上"（上一版就是这样）。
  ellipse 0,-136,150,34 fill=$杯身
  ellipse 0,-136,150,34 fill=none stroke=$线 width=10
  # 内壁的暗要画在"圈顶那一条"，画低了会被咖啡面盖住
  curve [-112,-160 0,-152 112,-160] w=12 stroke=#8A6A48 alpha=0.40 taper=0.2
  ellipse 0,-132,116,20 fill=$咖啡 name=咖啡面
  grad ref=咖啡面 from=#96613A to=#5A3418 p0=[0,-150] p1=[0,-114]
  ellipse 0,-132,116,20 fill=none stroke=#4A2C18 width=4

  # 7) 脸
  ellipse -56,-2,10,15 fill=$线
  ellipse 56,-2,10,15 fill=$线
  curve [-22,30 -6,42 22,28] w=6 stroke=$线 taper=0.3
  ellipse -96,30,20,10 fill=$腮红 alpha=0.75
  ellipse 96,30,20,10 fill=$腮红 alpha=0.75

endgroup

text 60,940 "马克杯 · 照参考图" 26 align=left color=#8A7360 hand=0.3
