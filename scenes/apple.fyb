canvas 1920x1080
bg #F7F0E3

hand preset=ink seed=64

# ── 桌面 ────────────────────────────────────────────
grad rect 0,900,1920,180 from=#EFE5D2 to=#E3D6BE dir=90
ink [0,900 1920,900] w=2.5 color=#CFC0A6 alpha=0.8 jitter=0.3

# ── 影子：投影体是一个扁椭圆，不是苹果本身 ──────────
# 跟着整个轮廓走的影子会像"贴纸浮在墙上"；真实的接触阴影是贴着地面的扁团。
# 再裁到桌面区域 —— 桌面平面从那条线开始，阴影不该漫到"墙上"。
ellipse 960,908,270,26 fill=none stroke=none name=sh
rect 0,900,1920,180 fill=none stroke=none name=tablearea
clip tablearea
  shadow ref=sh dx=4 dy=2 blur=14 alpha=0.50 color=#7E5836
  shadow ref=sh dx=16 dy=12 blur=46 alpha=0.22 color=#7E5836
endclip

# ── 苹果 ────────────────────────────────────────────
group at=[0,54]

curve [960,352 1046,318 1136,344 1204,412 1236,510 1232,614 1196,712 \
       1120,790 1040,846 990,858 960,830 930,858 880,846 800,790 724,712 \
       688,614 684,510 716,412 784,344 874,318] \
      fill=#C0392B closed name=apple

# 形体：光从左上打过来
clip apple
  grad circle 880,470,580 from=#E76248 to=#8C1A12
  grad circle 828,428,220 from=#FFFFFF8C to=#FFFFFF00
endclip

# 轮廓：一笔描下来
curve [960,352 1046,318 1136,344 1204,412 1236,510 1232,614 1196,712 \
       1120,790 1040,846 990,858 960,830 930,858 880,846 800,790 724,712 \
       688,614 684,510 716,412 784,344 874,318] \
      w=7 stroke=#5E120C taper=0.08 jitter=0.35 closed

# ── 果柄与叶子 ──────────────────────────────────────
curve [962,352 968,304 980,264 998,240] w=10 stroke=#6B4A2F taper=0.3 jitter=0.4
curve [990,258 1046,222 1112,226 1110,272 1032,292] fill=#5C9440 closed
ink [1000,282 1050,250 1100,240] w=3 color=#3F6B2C alpha=0.7 taper=0.6 jitter=0.3

endgroup

# ── 字 ──────────────────────────────────────────────
text 1560,1016 "苹果 · 小飞鱼" 26 align=left color=#8A7A62 hand=0.35

